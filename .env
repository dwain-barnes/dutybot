# DutyBot Configuration
# =====================
# NOTE: this file is committed to git — never put secrets (API keys, tokens) in here.

# Model settings
MODEL_REPO=EryriLabs/dutybot-GGUF
MODEL_FILE=domain_adapted-Q4_K_M.gguf
CTX_SIZE=4096
N_GPU_LAYERS=999

# Chat template passed to llama-server. The model card documents "chatml".
# Set to "embedded" to use the template baked into the GGUF instead — for this
# model that is the gpt-oss "harmony" template the base model was trained on,
# which may reduce training-artifact leakage. Worth A/B testing.
CHAT_TEMPLATE=chatml

# Port mappings (host:container)
DUTYBOT_PORT=5000
LLAMA_PORT=8080
SEARXNG_PORT=4000

# Chat settings
MAX_CONTEXT_MESSAGES=20
